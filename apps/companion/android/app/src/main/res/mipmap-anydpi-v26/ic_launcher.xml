<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </foreground>
  <!-- Themed ("monochrome") icons, Android 13+: the launcher tints this layer
       with the wallpaper palette when the user turns Themed icons on. Without
       it Talon is one of the odd icons left in full colour on a themed home
       screen. The falcon foreground is a transparent PNG, so its alpha is
       exactly the silhouette the launcher wants. Hand-added — re-add it if
       `dart run flutter_launcher_icons` ever regenerates this file. -->
  <monochrome>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </monochrome>
</adaptive-icon>
